# VisionBoard Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ──────────────────────────────────────────
# Database (PostgreSQL / Supabase)
# ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ──────────────────────────────────────────
# Auth (NextAuth.js v5)
# ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_32+_char_random_string"

# URL of this Next.js app (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ──────────────────────────────────────────
# AI (Anthropic Claude) — server-side only
# ──────────────────────────────────────────
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ──────────────────────────────────────────
# Backend API (Express server)
# ──────────────────────────────────────────
# URL of the visionboard-backend Express server
BACKEND_URL="http://localhost:4000"

# ──────────────────────────────────────────
# Admin Console (existing)
# ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying
ADMIN_SESSION_SECRET=replace_with_at_least_32_char_random_string

# ──────────────────────────────────────────
# Waitlist & Email (Resend)
# ──────────────────────────────────────────
VIP_ACCESS_CODE=REPLACE_WITH_YOUR_OWN_VIP_CODE
RESEND_API_KEY="re_..."
EMAIL_FROM="VisionBoard <onboarding@resend.dev>"

