# VisionBoard Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ──────────────────────────────────────────
# Database (PostgreSQL / Supabase)
# ──────────────────────────────────────────
# pgbouncer=true tells Prisma to use prepared-statement-free queries (required for PgBouncer).
# connection_limit=1 keeps each Prisma instance to one connection — PgBouncer multiplexes for you.
# pool_timeout=20 gives the pool extra time before throwing a timeout error.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ──────────────────────────────────────────
# Auth (NextAuth.js v5)
# ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_32+_char_random_string"

# URL of this Next.js app (used by NextAuth for callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Set to "true" ONLY for local HTTP development when HTTPS is unavailable.
# Never set this in staging or production.
# NEXTAUTH_COOKIE_INSECURE=true

# ──────────────────────────────────────────
# AI (OpenRouter) — server-side only
# ──────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# OPTIONAL — Direct OpenAI API key, used ONLY as a fallback when
# OPENROUTER_API_KEY is empty or fails. Leave blank to always route via
# OpenRouter (recommended: keeps all billing/usage in one place).
#OPENAI_API_KEY="sk-proj-..."

# RAG embedding model — used for workspace document similarity search.
# Defaults to "openai/text-embedding-3-small" if unset.
# OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# ──────────────────────────────────────────
# Backend API (Express server)
# ──────────────────────────────────────────
# URL of the visionboard-backend Express server (server-side only, used for internal calls)
BACKEND_URL="http://localhost:4000"

# Public WebSocket URL used by the browser live-cursor & board-sync client.
# SECURITY: This MUST be wss:// in production. If it starts with ws:// in
# production, the WebSocket hook will log a warning and disable itself to
# avoid sending session tokens in cleartext.
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# ──────────────────────────────────────────
# Admin Console
# ──────────────────────────────────────────
# REQUIRED — must be set before deployment. No default is provided intentionally.
# Use a strong random value: openssl rand -base64 32
# SECURITY: ADMIN_USERNAME must not be "admin" (blocked by validate-env.ts).
ADMIN_USERNAME=replace_with_non_default_username
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set to "true" ONLY for local HTTP development when HTTPS is unavailable.
# Never set this in staging or production.
# ADMIN_COOKIE_INSECURE=true

# ──────────────────────────────────────────
# Cron job authentication
# ──────────────────────────────────────────
# REQUIRED — protects /api/cron/sweeps and /api/cron/cleanup-users.
# Both routes reject all requests if this is unset in production.
# Generate with: openssl rand -base64 32  (minimum 32 characters)
CRON_SECRET=

# Set to "true" to disable the Vercel Cron IP allowlist check in local development.
# Never set in staging or production.
# CRON_DISABLE_IP_CHECK=true

# ──────────────────────────────────────────
# Supabase Webhooks (Database → Resend sync)
# ──────────────────────────────────────────
# SECURITY: REQUIRED in production. If this is empty/unset,
# /api/webhooks/supabase/users SKIPS ALL AUTHENTICATION and accepts
# unauthenticated webhook payloads (accounting/billing abuse risk).
# Generate a strong random value: openssl rand -base64 32
#
# Supabase Dashboard setup:
#   Database → Webhooks → Create → Table: User (public)
#   Events: INSERT, UPDATE, DELETE
#   URL: https://your-domain.com/api/webhooks/supabase/users
#   HTTP Header name: x-supabase-webhook-secret
#   HTTP Header value: <the secret you paste here>
SUPABASE_WEBHOOK_SECRET=

# ──────────────────────────────────────────
# Redis (Upstash) — REQUIRED in production
# ──────────────────────────────────────────
# SECURITY: Without Redis, rate limits and cron locks use a per-instance
# in-process Map. On Vercel / serverless deployments this means rate limits
# are bypassable (each lambda has its own counter) and cron double-fire
# deduplication does not work across replicas.
#
# Create a free Redis database at https://upstash.com/ and paste the
# REST URL and token here. validate-env.ts will fail at startup in
# production if either variable is missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────
# Waitlist & Email (Resend)
# ──────────────────────────────────────────
VIP_ACCESS_CODE=REPLACE_WITH_YOUR_OWN_VIP_CODE
RESEND_API_KEY="re_..."
RESEND_AUDIENCE_ID=""
EMAIL_FROM="VisionBoard <onboarding@resend.dev>"

# ──────────────────────────────────────────
# SMTP (Email Fallback — nodemailer)
# ──────────────────────────────────────────
# OPTIONAL. Resend is the primary email provider; these are used as a fallback
# ONLY when RESEND_API_KEY is not set. If you are only using Resend, leave all
# SMTP_* variables blank (strongly recommended to keep the primary path).
#
# SECURITY NOTE: Setting these activates nodemailer, which has a wider parsing
# attack surface than Resend's REST API. Only enable if you actually need SMTP.
#SMTP_HOST=smtp.your-provider.com
#SMTP_PORT=587
#SMTP_USER=your-smtp-username
#SMTP_PASS=your-smtp-password
# Set to "true" for port 465 (implicit TLS). Leave unset/false for port 587 STARTTLS.
#SMTP_SECURE=false

# ──────────────────────────────────────────
# Registration mode
# ──────────────────────────────────────────
# Set to "true" to require a valid waitlist invite token for new registrations.
# When false (default), registration is open to anyone.
WAITLIST_MODE=false

# ──────────────────────────────────────────
# App URL (used in server-generated emails — never trust client Origin header)
# ──────────────────────────────────────────
# Must match the public URL of this deployment. Used to build reset-password and
# invite email links. Falls back to NEXTAUTH_URL if not set.
# REQUIRED in production — validate-env.ts will fail at startup if both
# APP_URL and NEXTAUTH_URL are absent.
APP_URL="http://localhost:3000"

# ──────────────────────────────────────────
# Stripe Billing
# ──────────────────────────────────────────
# Find these in your Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
# For local dev use the Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs — create products & prices in Stripe Dashboard → Product catalog
# Then paste the price_xxx IDs here for each tier × billing period combination
STRIPE_PRICE_STARTUP_MONTHLY="price_..."
STRIPE_PRICE_STARTUP_ANNUAL="price_..."
STRIPE_PRICE_GROWTH_MONTHLY="price_..."
STRIPE_PRICE_GROWTH_ANNUAL="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_ANNUAL="price_..."


# ──────────────────────────────────────────
# MCP Discovery
# ──────────────────────────────────────────
# Required for MCP discovery endpoint
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ──────────────────────────────────────────
# WebMCP Origin Trial
# ──────────────────────────────────────────
# WebMCP Origin Trial token — register at https://developer.chrome.com/origintrials/#/trials/active
# Required for document.modelContext to work in Chrome 149+ without the chrome://flags override.
# Leave blank for local development (use chrome://flags/#enable-webmcp-testing instead).
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=

# ──────────────────────────────────────────
# Search Engine Verification (optional — rendered as site-wide <meta> tags)
# ──────────────────────────────────────────
# Get these from Google Search Console / Yandex Webmaster.
# When set, they are rendered as <meta name="google-site-verification" content="...">
# and <meta name="yandex-verification" content="..."> in the <head> of every page.
# Both are intentionally public (the providers require them to prove domain ownership).
#NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#NEXT_PUBLIC_YANDEX_VERIFICATION=
