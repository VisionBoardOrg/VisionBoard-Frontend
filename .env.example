# VisionBoard Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ──────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────
# Prisma requires two connection strings for PostgreSQL with connection pooling.
# See: https://www.prisma.io/docs/guides/performance-and-optimization/connection-management
#
# Option A — Supabase (recommended for quick setup):
#   DATABASE_URL comes from: Project Settings → Database → Transaction pooler (port 6543)
#   DIRECT_URL  comes from: Project Settings → Database → Session pooler / direct (port 5432)
#
# Option B — Any PostgreSQL host:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"


# ──────────────────────────────────────────
# Admin Console
# ──────────────────────────────────────────
# Username for the admin login page (/admin/login)
ADMIN_USERNAME=admin

# Password for the admin login page — change this before deploying!
ADMIN_PASSWORD=change_me_before_deploying

# A secret key used to HMAC-sign the admin session cookie.
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace_with_at_least_32_char_random_string

# ──────────────────────────────────────────
# Waitlist
# ──────────────────────────────────────────
# VIP access code that grants instant waitlist bypass.
# Share this only through private/secure channels.
VIP_ACCESS_CODE=REPLACE_WITH_YOUR_OWN_VIP_CODE
