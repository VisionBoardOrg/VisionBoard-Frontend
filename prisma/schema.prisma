// VisionBoard — Full Product Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// AUTH (NextAuth.js v5 required tables)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  hashedPassword String?  // null for OAuth-only users
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  ownedWorkspaces Workspace[]   @relation("WorkspaceOwner")

  assignedTasks Task[]          @relation("TaskAssignee")
  comments      Comment[]
  activityLogs  ActivityLog[]
  aiLogs        AIGenerationLog[]
  documents     Document[]      @relation("DocumentAuthor")
  invitationsSent WorkspaceInvite[] @relation("InvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// WORKSPACE & MEMBERS
// ─────────────────────────────────────────────

enum PlanTier {
  free
  startup
  growth
  enterprise
}

enum MemberRole {
  pm
  exec
  eng
  marketing
  admin
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      PlanTier  @default(free)
  ownerId   String
  owner     User      @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  aiCreditsUsed Int   @default(0) // resets monthly
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members     WorkspaceMember[]
  goals       Goal[]
  sprints     Sprint[]
  documents   Document[]
  boardItems  BoardItem[]
  activityLogs ActivityLog[]
  aiLogs      AIGenerationLog[]
  invites     WorkspaceInvite[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(pm)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// GOALS → MILESTONES → TASKS
// ─────────────────────────────────────────────

enum GoalStatus {
  draft
  active
  completed
  cancelled
}

model Goal {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  objective   String     @db.Text
  keyResults  Json       @default("[]") // KeyResult[]
  status      GoalStatus @default(draft)
  healthScore Int        @default(0)    // 0-100 computed score
  targetDate  DateTime?
  ownerId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  documents  Document[]  @relation("GoalDocuments")
  boardItems BoardItem[] @relation("GoalBoardItems")
  comments   Comment[]   @relation("GoalComments")

  @@index([workspaceId])
  @@index([status])
}

enum MilestoneStatus {
  planned
  in_progress
  completed
  delayed
}

model Milestone {
  id          String          @id @default(cuid())
  goalId      String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(planned)
  targetDate  DateTime?
  startDate   DateTime?
  dependsOn   String[]        // array of Milestone ids
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal       Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks      Task[]
  documents  Document[] @relation("MilestoneDocuments")
  boardItems BoardItem[] @relation("MilestoneBoardItems")
  comments   Comment[]  @relation("MilestoneComments")

  @@index([goalId])
  @@index([status])
}

enum TaskStatus {
  todo
  in_progress
  in_review
  blocked
  done
}

enum Priority {
  low
  medium
  high
  urgent
}

model Task {
  id          String     @id @default(cuid())
  milestoneId String
  title       String
  description String?    @db.Text
  status      TaskStatus @default(todo)
  priority    Priority   @default(medium)
  assigneeId  String?
  sprintId    String?
  storyPoints Int?
  dueDate     DateTime?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sprint    Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  documents Document[] @relation("TaskDocuments")
  comments  Comment[]  @relation("TaskComments")

  @@index([milestoneId])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([status])
}

// ─────────────────────────────────────────────
// SPRINTS
// ─────────────────────────────────────────────

enum SprintStatus {
  planned
  active
  completed
}

model Sprint {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("planned")
  velocity    Int?     // planned story points
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@index([status])
}

// ─────────────────────────────────────────────
// DOCUMENTS (Connected Docs)
// ─────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     Json     @default("{}") // Tiptap JSON doc
  authorId    String?

  // Optional links to any entity
  linkedGoalId      String?
  linkedMilestoneId String?
  linkedTaskId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author          User?      @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  linkedGoal      Goal?      @relation("GoalDocuments", fields: [linkedGoalId], references: [id], onDelete: SetNull)
  linkedMilestone Milestone? @relation("MilestoneDocuments", fields: [linkedMilestoneId], references: [id], onDelete: SetNull)
  linkedTask      Task?      @relation("TaskDocuments", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  comments        Comment[]  @relation("DocumentComments")

  @@index([workspaceId])
  @@index([linkedGoalId])
  @@index([linkedMilestoneId])
  @@index([linkedTaskId])
}

// ─────────────────────────────────────────────
// 2D BOARD ITEMS
// ─────────────────────────────────────────────

enum BoardEntityType {
  goal
  milestone
  task
  note
}

model BoardItem {
  id              String          @id @default(cuid())
  workspaceId     String
  x               Float           @default(0)
  y               Float           @default(0)
  width           Float           @default(200)
  height          Float           @default(120)
  entityType      BoardEntityType
  linkedGoalId      String?
  linkedMilestoneId String?
  linkedTaskId      String?
  color           String?         // custom color override
  label           String?         // custom label override (for note type)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedGoal      Goal?      @relation("GoalBoardItems", fields: [linkedGoalId], references: [id], onDelete: Cascade)
  linkedMilestone Milestone? @relation("MilestoneBoardItems", fields: [linkedMilestoneId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// COMMENTS
// ─────────────────────────────────────────────

enum CommentEntityType {
  goal
  milestone
  task
  document
}

model Comment {
  id         String            @id @default(cuid())
  body       String            @db.Text
  authorId   String
  entityType CommentEntityType
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Linked entity (only one will be set)
  goalId      String?
  milestoneId String?
  taskId      String?
  documentId  String?

  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  linkedGoal      Goal?      @relation("GoalComments", fields: [goalId], references: [id], onDelete: Cascade)
  linkedMilestone Milestone? @relation("MilestoneComments", fields: [milestoneId], references: [id], onDelete: Cascade)
  linkedTask      Task?      @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  linkedDocument  Document?  @relation("DocumentComments", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([goalId])
  @@index([milestoneId])
  @@index([taskId])
}

// ─────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  entityType  String   // "goal" | "milestone" | "task" | "document"
  entityId    String
  action      String   // "created" | "updated" | "deleted" | "moved" | "assigned"
  diff        Json?    // { before, after }
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// AI GENERATION LOG
// ─────────────────────────────────────────────

enum AIFeature {
  roadmap_generator
  goal_deconstructor
  progress_insights
  nl_board_edit
}

model AIGenerationLog {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  feature       AIFeature
  promptInput   String    @db.Text
  modelOutput   String    @db.Text
  entityCreated String?   // JSON ref: { type, id }
  tokensUsed    Int       @default(0)
  accepted      Boolean?  // null = pending review, true = applied, false = rejected
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([feature])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// WAITLIST (preserved from marketing site)
// ─────────────────────────────────────────────

model WaitlistEntry {
  id              String    @id @default(cuid())
  email           String    @unique
  fullName        String
  company         String?
  teamSize        String?
  role            String
  painPoint       String?
  referralCode    String    @unique
  referredBy      String?
  referralCount   Int       @default(0)
  position        Int
  status          String    @default("PENDING") // PENDING, INVITED, REGISTERED, EXPIRED
  inviteToken     String?   @unique
  invitedAt       DateTime?
  sharedPlatforms String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([position])
}

// ─────────────────────────────────────────────
// WORKSPACE INVITATIONS
// ─────────────────────────────────────────────

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("pm") // pm, exec, eng, marketing, admin
  token       String   @unique @default(cuid())
  inviterId   String
  status      String   @default("pending") // pending, accepted, expired, cancelled
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
}

