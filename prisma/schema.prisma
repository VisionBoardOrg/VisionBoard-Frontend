generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  name                String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  emailVerified       DateTime?
  image               String?
  hashedPassword      String?
  plan                PlanTier          @default(free)
  aiCreditsUsed       Int               @default(0)
  // ── Stripe Billing ────────────────────────────────────────────────────────
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  stripeCancelAtPeriodEnd Boolean @default(false)
  /// Set when the user requests account deletion. The account is permanently
  /// purged 30 days after this date by the nightly cleanup cron job.
  scheduledDeletion   DateTime?
  aiLogs          AIGenerationLog[]
  accounts        Account[]
  activityLogs    ActivityLog[]
  comments        Comment[]
  documents       Document[]        @relation("DocumentAuthor")
  sessions        Session[]
  assignedTasks   Task[]            @relation("TaskAssignee")
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  invitationsSent WorkspaceInvite[] @relation("InvitationsSent")
  memberships     WorkspaceMember[]
  notifications   Notification[]    @relation("UserNotifications")
  triggeredNotifications Notification[] @relation("ActorNotifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ownerId       String
  /// Pre-computed total bytes of document content stored in this workspace.
  /// Incremented/decremented atomically on document create/delete so storage
  /// checks are O(1) instead of scanning all document content rows.
  storageUsedBytes BigInt         @default(0)
  aiLogs        AIGenerationLog[]
  activityLogs  ActivityLog[]
  boardItems    BoardItem[]
  documents     Document[]
  goals         Goal[]
  sprints       Sprint[]
  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  invites       WorkspaceInvite[]
  members       WorkspaceMember[]
  notifications Notification[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(pm)
  joinedAt    DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Goal {
  id          String      @id @default(cuid())
  workspaceId String
  title       String
  objective   String
  keyResults  Json        @default("[]")
  status      GoalStatus  @default(draft)
  healthScore Int         @default(0)
  targetDate  DateTime?
  ownerId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  boardItems  BoardItem[] @relation("GoalBoardItems")
  comments    Comment[]   @relation("GoalComments")
  documents   Document[]  @relation("GoalDocuments")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@index([workspaceId])
  @@index([status])
}

model Milestone {
  id          String          @id @default(cuid())
  goalId      String
  title       String
  description String?
  status      MilestoneStatus @default(planned)
  startDate           DateTime?
  targetDate          DateTime?
  baselineStartDate   DateTime?
  baselineTargetDate  DateTime?
  dependsOn           String[]
  order               Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  boardItems  BoardItem[]     @relation("MilestoneBoardItems")
  comments    Comment[]       @relation("MilestoneComments")
  documents   Document[]      @relation("MilestoneDocuments")
  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([goalId])
  @@index([status])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  assigneeId  String?
  sprintId    String?
  dueDate     DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  storyPoints Int?
  milestoneId String
  order       Int        @default(0)
  status        TaskStatus @default(todo)
  priority      Priority   @default(medium)
  blockedReason String?
  comments      Comment[]  @relation("TaskComments")
  documents   Document[] @relation("TaskDocuments")
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  sprint      Sprint?    @relation(fields: [sprintId], references: [id])

  @@index([milestoneId])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([status])
  @@index([milestoneId, order])
  @@index([sprintId, status])
}

model Sprint {
  id          String    @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("planned")
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  velocity    Int?
  goal        String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([workspaceId])
  @@index([status])
}

model Document {
  id                String     @id @default(cuid())
  title             String
  authorId          String?
  workspaceId       String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  linkedGoalId      String?
  linkedMilestoneId String?
  linkedTaskId      String?
  content           Json       @default("{}")
  comments          Comment[]  @relation("DocumentComments")
  author            User?      @relation("DocumentAuthor", fields: [authorId], references: [id])
  linkedGoal        Goal?      @relation("GoalDocuments", fields: [linkedGoalId], references: [id])
  linkedMilestone   Milestone? @relation("MilestoneDocuments", fields: [linkedMilestoneId], references: [id])
  linkedTask        Task?      @relation("TaskDocuments", fields: [linkedTaskId], references: [id])
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([linkedGoalId])
  @@index([linkedMilestoneId])
  @@index([linkedTaskId])
}

model BoardItem {
  id                String          @id @default(cuid())
  workspaceId       String
  x                 Float           @default(0)
  y                 Float           @default(0)
  width             Float           @default(200)
  height            Float           @default(120)
  entityType        BoardEntityType
  linkedGoalId      String?
  linkedMilestoneId String?
  linkedTaskId      String?
  color             String?
  label             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  linkedGoal        Goal?           @relation("GoalBoardItems", fields: [linkedGoalId], references: [id], onDelete: Cascade)
  linkedMilestone   Milestone?      @relation("MilestoneBoardItems", fields: [linkedMilestoneId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([linkedGoalId])
  @@index([linkedMilestoneId])
  @@index([linkedTaskId])
}

model Comment {
  id              String            @id @default(cuid())
  body            String
  authorId        String
  entityType      CommentEntityType
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  goalId          String?
  milestoneId     String?
  taskId          String?
  documentId      String?
  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  linkedDocument  Document?         @relation("DocumentComments", fields: [documentId], references: [id], onDelete: Cascade)
  linkedGoal      Goal?             @relation("GoalComments", fields: [goalId], references: [id], onDelete: Cascade)
  linkedMilestone Milestone?        @relation("MilestoneComments", fields: [milestoneId], references: [id], onDelete: Cascade)
  linkedTask      Task?             @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([goalId])
  @@index([milestoneId])
  @@index([taskId])
  @@index([documentId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  entityType  String
  entityId    String
  action      String
  diff        Json?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model AIGenerationLog {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  feature       AIFeature
  promptInput   String
  modelOutput   String
  entityCreated String?
  tokensUsed    Int       @default(0)
  accepted      Boolean?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([feature])
  @@index([createdAt])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("pm")
  token       String    @unique @default(cuid())
  inviterId   String
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  inviter     User      @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
}

enum PlanTier {
  free
  startup
  growth
  enterprise
}

enum MemberRole {
  pm
  exec
  eng
  marketing
  admin
}

enum GoalStatus {
  draft
  active
  completed
  cancelled
}

enum MilestoneStatus {
  planned
  in_progress
  completed
  delayed
}

enum TaskStatus {
  todo
  in_progress
  in_review
  blocked
  done
}

enum Priority {
  low
  medium
  high
  urgent
}

enum SprintStatus {
  planned
  active
  completed
}

enum BoardEntityType {
  goal
  milestone
  task
  note
}

enum CommentEntityType {
  goal
  milestone
  task
  document
}

enum AIFeature {
  roadmap_generator
  goal_deconstructor
  progress_insights
  nl_board_edit
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String?
  actorId     String?
  type        NotificationType
  title       String
  message     String
  entityType  String?
  entityId    String?
  link        String?
  read        Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  user        User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([workspaceId])
  @@index([createdAt])
}

enum NotificationType {
  task_assigned
  task_status_changed
  task_blocked
  task_due_soon
  task_overdue
  milestone_delayed
  milestone_completed
  goal_at_risk
  goal_health_degraded
  comment_mention
  comment_created
  workspace_invite
  role_changed
  quota_warning
  quota_exceeded
  billing_payment_failed
  billing_payment_succeeded
  system_alert

  // Legacy uppercase variants for backward compatibility with existing DB rows
  TASK_ASSIGNED
  COMMENT_ADDED
  USER_MENTIONED
  GOAL_HEALTH_WARNING
  MILESTONE_DELAYED
  WORKSPACE_INVITE
}

